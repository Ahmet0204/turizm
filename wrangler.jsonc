{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "turizm",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  // Sürüm deneme adresleri (<sürüm>-turizm.tokmak.workers.dev) kapalı
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  // Her saat başı fakülte sitesinden haberleri çek (src/news.js)
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "turizm-db",
      "database_id": "fbda94e6-aef4-41ff-9a89-fbd6fde23bf8",
      "migrations_dir": "migrations"
    }
  ],
  // Gizli değerler `wrangler secret` ile tanımlıdır: SESSION_SECRET, VAPID_PRIVATE_JWK
  "vars": {
    "VAPID_PUBLIC_KEY": "BLPUNYixDblUxDhxIqAlBo9oF3PXOrXaDzk_1C3xUn6ptZvhv78nls3BReSl8RO2TeiI0W9mUMx4ZpA0lL9QQ88",
    "VAPID_SUBJECT": "https://turizm.tokmak.workers.dev"
  }
}
